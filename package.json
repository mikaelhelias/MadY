{
  "name": "mady",
  "version": "0.0.0",
  "private": true,
  "description": "MadY — a modern scientific graphing and statistics application.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build:renderer": "npm run build --workspace apps/desktop",
    "e2e": "playwright test --project chromium",
    "e2e:sweeps": "playwright test --project sweeps",
    "e2e:all": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint apps/desktop/src packages --max-warnings 0 && npm run typecheck:unused",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "typecheck:unused": "tsc -p apps/desktop/tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters && tsc -p packages/mcp-server/tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters",
    "licenses": "node scripts/gen-third-party-notices.mjs"
  },
  "overrides": {
    "exceljs": {
      "unzipper": "0.12.5"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.9"
  }
}
